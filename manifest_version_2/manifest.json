{
  "manifest_version": 2,  "name": "Decode Extension",
  "version": "1.0",
  "description": "Decode selected text as URL-encoded, Base64-encoded, Hex, or Unicode.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "thruntellisearch": {
    "scheme": "http",
    "host": "127.0.0.1",
    "port": 5000
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["toast.js"],
      "css": ["toast.css"],
      "run_at": "document_end"
    }
  ]
}